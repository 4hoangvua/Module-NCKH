{
  "cues": [
    {
      "id": 1,
      "start": 0.0,
      "end": 2.88,
      "text": "不说话还能圈粉全场,鬼面的第一反差萌",
      "confidence": -0.117
    },
    {
      "id": 2,
      "start": 2.88,
      "end": 5.6,
      "text": "迷豆子用行动告诉你,什么才叫萌的翻观众",
      "confidence": -0.117
    },
    {
      "id": 3,
      "start": 5.6,
      "end": 6.52,
      "text": "打得过流氓",
      "confidence": -0.117
    },
    {
      "id": 4,
      "start": 6.52,
      "end": 9.28,
      "text": "迷豆子整日咬着主筒,根本不能开口说话",
      "confidence": -0.117
    },
    {
      "id": 5,
      "start": 9.28,
      "end": 12.08,
      "text": "仅凭几句简单的发声,跟一脸无辜的表情",
      "confidence": -0.117
    },
    {
      "id": 6,
      "start": 12.08,
      "end": 13.64,
      "text": "就融化了所有观众的心",
      "confidence": -0.117
    },
    {
      "id": 7,
      "start": 13.64,
      "end": 15.96,
      "text": "如果非要给迷豆子的可爱名场面排名",
      "confidence": -0.117
    },
    {
      "id": 8,
      "start": 15.96,
      "end": 18.32,
      "text": "那和香奈乎的首次交锋毕竟前三",
      "confidence": -0.117
    },
    {
      "id": 9,
      "start": 18.32,
      "end": 20.56,
      "text": "香奈乎每日的察觉到迷豆子的身份",
      "confidence": -0.117
    },
    {
      "id": 10,
      "start": 20.56,
      "end": 23.32,
      "text": "二话不说拔刀就砍,眼看迷豆子就要受伤",
      "confidence": -0.117
    },
    {
      "id": 11,
      "start": 23.32,
      "end": 25.6,
      "text": "只见他不躲不闪,身体骤然变小",
      "confidence": -0.117
    },
    {
      "id": 12,
      "start": 25.6,
      "end": 27.04,
      "text": "蹦带着朝远处逃走",
      "confidence": -0.1137
    },
    {
      "id": 13,
      "start": 27.04,
      "end": 28.44,
      "text": "香奈乎看了一脸懵逼",
      "confidence": -0.1137
    },
    {
      "id": 14,
      "start": 28.44,
      "end": 30.6,
      "text": "完全没想到鬼戒还有这么可爱的存在",
      "confidence": -0.1137
    },
    {
      "id": 15,
      "start": 30.6,
      "end": 31.68,
      "text": "不过她并没手软",
      "confidence": -0.1137
    },
    {
      "id": 16,
      "start": 31.68,
      "end": 33.12,
      "text": "随后连续又是几刀",
      "confidence": -0.1137
    },
    {
      "id": 17,
      "start": 33.12,
      "end": 34.72,
      "text": "迷豆子愣是听声辨慰",
      "confidence": -0.1137
    },
    {
      "id": 18,
      "start": 34.72,
      "end": 36.2,
      "text": "头也不回就化解了危机",
      "confidence": -0.1137
    },
    {
      "id": 19,
      "start": 36.2,
      "end": 37.68,
      "text": "后来迷豆子遇上蜜璃",
      "confidence": -0.1137
    },
    {
      "id": 20,
      "start": 37.68,
      "end": 38.92,
      "text": "那才叫一见如故",
      "confidence": -0.1137
    },
    {
      "id": 21,
      "start": 38.92,
      "end": 40.88,
      "text": "也许小孩子都喜欢漂亮姐姐",
      "confidence": -0.1137
    },
    {
      "id": 22,
      "start": 40.88,
      "end": 42.48,
      "text": "而且蜜璃那是真惯着她",
      "confidence": -0.1137
    },
    {
      "id": 23,
      "start": 42.48,
      "end": 43.96,
      "text": "吃饭睡觉都不分开",
      "confidence": -0.1137
    },
    {
      "id": 24,
      "start": 43.96,
      "end": 44.76,
      "text": "时间长了",
      "confidence": -0.1137
    },
    {
      "id": 25,
      "start": 44.76,
      "end": 45.88,
      "text": "迷豆子一举一动",
      "confidence": -0.1137
    },
    {
      "id": 26,
      "start": 45.88,
      "end": 47.12,
      "text": "都跟蜜璃一模一样",
      "confidence": -0.1137
    },
    {
      "id": 27,
      "start": 47.12,
      "end": 49.6,
      "text": "甚至还让哥哥帮她也梳了蜜璃同款发型",
      "confidence": -0.1137
    },
    {
      "id": 28,
      "start": 49.6,
      "end": 50.96,
      "text": "后来上了无限列车",
      "confidence": -0.103
    },
    {
      "id": 29,
      "start": 50.96,
      "end": 52.24,
      "text": "炭治郎昏睡不醒",
      "confidence": -0.103
    },
    {
      "id": 30,
      "start": 52.24,
      "end": 53.76,
      "text": "迷豆子用头暴力撞击",
      "confidence": -0.103
    },
    {
      "id": 31,
      "start": 53.76,
      "end": 55.4,
      "text": "没想到哥哥的头比他还硬",
      "confidence": -0.103
    },
    {
      "id": 32,
      "start": 55.4,
      "end": 56.56,
      "text": "直接额头出血",
      "confidence": -0.103
    },
    {
      "id": 33,
      "start": 56.56,
      "end": 58.16,
      "text": "即便有瞬间恢复的能力",
      "confidence": -0.103
    },
    {
      "id": 34,
      "start": 58.16,
      "end": 59.72,
      "text": "迷豆子依然是痛得流泪",
      "confidence": -0.103
    },
    {
      "id": 35,
      "start": 59.72,
      "end": 60.88,
      "text": "后来炭治郎醒了",
      "confidence": -0.103
    },
    {
      "id": 36,
      "start": 60.88,
      "end": 62.16,
      "text": "想靠近看看情况",
      "confidence": -0.103
    },
    {
      "id": 37,
      "start": 62.16,
      "end": 64.0,
      "text": "吓得迷豆子赶紧双手抱头",
      "confidence": -0.103
    },
    {
      "id": 38,
      "start": 64.0,
      "end": 65.32,
      "text": "生怕再次受伤",
      "confidence": -0.103
    },
    {
      "id": 39,
      "start": 65.32,
      "end": 66.88,
      "text": "由于他呆萌可爱的造型",
      "confidence": -0.103
    },
    {
      "id": 40,
      "start": 66.88,
      "end": 68.48,
      "text": "让人低估了他的战斗能力",
      "confidence": -0.103
    },
    {
      "id": 41,
      "start": 68.48,
      "end": 69.8,
      "text": "再由过炭治郎重伤",
      "confidence": -0.103
    },
    {
      "id": 42,
      "start": 69.8,
      "end": 71.64,
      "text": "迷豆子被激发出二段进化",
      "confidence": -0.103
    },
    {
      "id": 43,
      "start": 71.64,
      "end": 73.24,
      "text": "即便是位列上前的舵鸡",
      "confidence": -0.103
    },
    {
      "id": 44,
      "start": 73.24,
      "end": 74.92,
      "text": "在他手下也只有挨孽的粪",
      "confidence": -0.103
    },
    {
      "id": 45,
      "start": 74.92,
      "end": 78.0,
      "text": "被迷豆子42号大叫 活生生贯穿了身体",
      "confidence": -0.117
    },
    {
      "id": 46,
      "start": 78.0,
      "end": 80.76,
      "text": "迷豆子的血鬼术还具有非凡的治愈能力",
      "confidence": -0.117
    },
    {
      "id": 47,
      "start": 80.76,
      "end": 82.48,
      "text": "都知道姬夫太郎用的是梅毒",
      "confidence": -0.117
    },
    {
      "id": 48,
      "start": 82.48,
      "end": 84.2,
      "text": "一般方法根本不可能根治",
      "confidence": -0.117
    },
    {
      "id": 49,
      "start": 84.2,
      "end": 86.36,
      "text": "可毒素禁不住迷豆子鬼火焚烧",
      "confidence": -0.117
    },
    {
      "id": 50,
      "start": 86.36,
      "end": 88.32,
      "text": "这一幕吓坏了阴柱的三位妻子",
      "confidence": -0.117
    },
    {
      "id": 51,
      "start": 88.32,
      "end": 89.28,
      "text": "他们一直认为",
      "confidence": -0.117
    },
    {
      "id": 52,
      "start": 89.28,
      "end": 91.48,
      "text": "是迷豆子要提前火化重伤的丈夫",
      "confidence": -0.117
    },
    {
      "id": 53,
      "start": 94.48,
      "end": 95.88,
      "text": "刚变身厉鬼的迷豆子",
      "confidence": -0.117
    },
    {
      "id": 54,
      "start": 95.88,
      "end": 97.32,
      "text": "人类意识逐渐消失",
      "confidence": -0.117
    },
    {
      "id": 55,
      "start": 97.32,
      "end": 99.16,
      "text": "幸亏贪治郎从小哄她睡觉",
      "confidence": -0.117
    },
    {
      "id": 56,
      "start": 99.16,
      "end": 100.72,
      "text": "知道妹妹最爱听的歌曲",
      "confidence": -0.117
    },
    {
      "id": 57,
      "start": 100.72,
      "end": 102.24,
      "text": "用儿歌唤起了她的记忆",
      "confidence": -0.117
    },
    {
      "id": 58,
      "start": 102.24,
      "end": 103.88,
      "text": "迷豆子想起了自己的母亲",
      "confidence": -0.117
    },
    {
      "id": 59,
      "start": 103.88,
      "end": 105.96,
      "text": "同时他瞪着一双大眼的可爱造型",
      "confidence": -0.0973
    },
    {
      "id": 60,
      "start": 105.96,
      "end": 107.8,
      "text": "也成了无数观众的梦中情娃",
      "confidence": -0.0973
    },
    {
      "id": 61,
      "start": 107.8,
      "end": 109.12,
      "text": "咪豆子恢复了人性",
      "confidence": -0.0973
    },
    {
      "id": 62,
      "start": 109.12,
      "end": 110.68,
      "text": "身体也缩成了迷你版本",
      "confidence": -0.0973
    },
    {
      "id": 63,
      "start": 110.68,
      "end": 111.64,
      "text": "他全程一团",
      "confidence": -0.0973
    },
    {
      "id": 64,
      "start": 111.64,
      "end": 113.24,
      "text": "在哥哥脚下沉沉睡去",
      "confidence": -0.0973
    },
    {
      "id": 65,
      "start": 113.24,
      "end": 114.72,
      "text": "随着战斗经验的增加",
      "confidence": -0.0973
    },
    {
      "id": 66,
      "start": 114.72,
      "end": 116.64,
      "text": "咪豆子已经能够控制鬼话程度",
      "confidence": -0.0973
    },
    {
      "id": 67,
      "start": 116.64,
      "end": 117.92,
      "text": "就比如在断刀村",
      "confidence": -0.0973
    },
    {
      "id": 68,
      "start": 117.92,
      "end": 119.56,
      "text": "听到炭治郎叫自己名字",
      "confidence": -0.0973
    },
    {
      "id": 69,
      "start": 119.56,
      "end": 121.32,
      "text": "仍然呆萌的举手给出反应",
      "confidence": -0.0973
    },
    {
      "id": 70,
      "start": 121.32,
      "end": 122.88,
      "text": "咪豆子平时被哥哥保护",
      "confidence": -0.0973
    },
    {
      "id": 71,
      "start": 122.88,
      "end": 124.68,
      "text": "危险时反过来就踏于水火",
      "confidence": -0.0973
    },
    {
      "id": 72,
      "start": 124.68,
      "end": 125.68,
      "text": "不管多么危险",
      "confidence": -0.0973
    },
    {
      "id": 73,
      "start": 125.68,
      "end": 127.64,
      "text": "兄妹二人从没想过放弃对方",
      "confidence": -0.0973
    },
    {
      "id": 74,
      "start": 127.64,
      "end": 129.08,
      "text": "这样又萌又撒的妹妹",
      "confidence": -0.0973
    },
    {
      "id": 75,
      "start": 129.08,
