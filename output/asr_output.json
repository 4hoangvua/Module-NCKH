{
  "cues": [
    {
      "id": 1,
      "start": 0.0,
      "end": 2.8,
      "text": "诶 你长这么别子 你是个什么东西啊",
      "confidence": -0.2689
    },
    {
      "id": 2,
      "start": 2.8,
      "end": 4.4,
      "text": "啊 不明显吗",
      "confidence": -0.2689
    },
    {
      "id": 3,
      "start": 4.4,
      "end": 5.4,
      "text": "啊",
      "confidence": -0.2689
    },
    {
      "id": 4,
      "start": 5.4,
      "end": 10.58,
      "text": "哦 原来你是个鸡精啊 怪不得闻起来这么歇",
      "confidence": -0.2689
    },
    {
      "id": 5,
      "start": 10.58,
      "end": 11.58,
      "text": "啊",
      "confidence": -0.2689
    },
    {
      "id": 6,
      "start": 11.58,
      "end": 14.58,
      "text": "我很好奇 你为什么要选择做鸡呢",
      "confidence": -0.2689
    },
    {
      "id": 7,
      "start": 14.58,
      "end": 16.62,
      "text": "你就没考虑过做其他动物吗",
      "confidence": -0.2689
    },
    {
      "id": 8,
      "start": 16.62,
      "end": 18.62,
      "text": "那你为什么要做鸭",
      "confidence": -0.2689
    },
    {
      "id": 9,
      "start": 18.62,
      "end": 21.18,
      "text": "这不生下来就注定了吗",
      "confidence": -0.2689
    },
    {
      "id": 10,
      "start": 21.18,
      "end": 22.68,
      "text": "你说的我好像能选",
      "confidence": -0.2689
    },
    {
      "id": 11,
      "start": 22.68,
      "end": 23.68,
      "text": "是的",
      "confidence": -0.2689
    },
    {
      "id": 12,
      "start": 23.68,
      "end": 24.68,
      "text": "啊 不能选吗",
      "confidence": -0.2689
    },
    {
      "id": 13,
      "start": 24.68,
      "end": 28.18,
      "text": "哦 那假如有的选 那你会当什么啊",
      "confidence": -0.2689
    },
    {
      "id": 14,
      "start": 28.18,
      "end": 29.18,
      "text": "我会去当个妈布",
      "confidence": -0.2689
    },
    {
      "id": 15,
      "start": 29.18,
      "end": 30.68,
      "text": "哦 为什么",
      "confidence": -0.2689
    },
    {
      "id": 16,
      "start": 30.68,
      "end": 32.28,
      "text": "为了把你这张臭嘴塞起来",
      "confidence": -0.2494
    },
    {
      "id": 17,
      "start": 32.28,
      "end": 33.0,
      "text": "绑住",
      "confidence": -0.2494
    },
    {
      "id": 18,
      "start": 33.0,
      "end": 34.52,
      "text": "然后再铲上两百圈",
      "confidence": -0.2494
    },
    {
      "id": 19,
      "start": 34.52,
      "end": 35.48,
      "text": "这样",
      "confidence": -0.2494
    },
    {
      "id": 20,
      "start": 35.48,
      "end": 39.7,
      "text": "这个世界就清静了",
      "confidence": -0.2494
    },
    {
      "id": 21,
      "start": 39.7,
      "end": 40.66,
      "text": "你真调皮",
      "confidence": -0.2494
    },
    {
      "id": 22,
      "start": 40.66,
      "end": 41.34,
      "text": "嘿嘿嘿",
      "confidence": -0.2494
    },
    {
      "id": 23,
      "start": 41.34,
      "end": 42.74,
      "text": "哈",
      "confidence": -0.2494
    },
    {
      "id": 24,
      "start": 42.74,
      "end": 43.7,
      "text": "哎 小基金",
      "confidence": -0.2494
    },
    {
      "id": 25,
      "start": 43.7,
      "end": 46.06,
      "text": "你平时有什么爱好没有啊",
      "confidence": -0.2494
    },
    {
      "id": 26,
      "start": 46.06,
      "end": 47.58,
      "text": "平时就唱着歌 画个画",
      "confidence": -0.2494
    },
    {
      "id": 27,
      "start": 47.58,
      "end": 48.74,
      "text": "跳个舞什么的",
      "confidence": -0.2494
    },
    {
      "id": 28,
      "start": 48.74,
      "end": 50.18,
      "text": "那你平时打篮球吗",
      "confidence": -0.2494
    },
    {
      "id": 29,
      "start": 50.18,
      "end": 50.82,
      "text": "啊",
      "confidence": -0.2494
    },
    {
      "id": 30,
      "start": 50.82,
      "end": 52.18,
      "text": "打篮球",
      "confidence": -0.2494
    },
    {
      "id": 31,
      "start": 52.18,
      "end": 53.9,
      "text": "打什么篮球 打什么篮球",
      "confidence": -0.2494
    },
    {
      "id": 32,
      "start": 53.9,
      "end": 54.78,
      "text": "你告诉我",
      "confidence": -0.2494
    },
    {
      "id": 33,
      "start": 54.78,
      "end": 55.94,
      "text": "鸡怎么打篮球",
      "confidence": -0.2494
    },
    {
      "id": 34,
      "start": 55.94,
      "end": 57.7,
      "text": "你不要那么激动啊 小基金",
      "confidence": -0.2494
    },
    {
      "id": 35,
      "start": 57.7,
      "end": 60.4,
      "text": "不是我问的 是网友问的啦",
      "confidence": -0.2494
    },
    {
      "id": 36,
      "start": 60.4,
      "end": 61.96,
      "text": "不要一直激进激进的叫",
      "confidence": -0.2494
    },
    {
      "id": 37,
      "start": 61.96,
      "end": 63.4,
      "text": "听着就烦人了",
      "confidence": -0.2494
    },
    {
      "id": 38,
      "start": 63.4,
      "end": 64.4,
      "text": "我又不是调料",
      "confidence": -0.3729
    },
    {
      "id": 39,
      "start": 64.92,
      "end": 66.32,
      "text": "那就叫你鸡腰",
      "confidence": -0.3729
    },
    {
      "id": 40,
      "start": 66.32,
      "end": 67.24,
      "text": "不叫鸡腰",
      "confidence": -0.3729
    },
    {
      "id": 41,
      "start": 67.24,
      "end": 68.32,
      "text": "难听死的",
      "confidence": -0.3729
    },
    {
      "id": 42,
      "start": 68.84,
      "end": 70.44,
      "text": "那就叫腰鸡",
      "confidence": -0.3729
    },
    {
      "id": 43,
      "start": 71.16,
      "end": 72.12,
      "text": "要什么鸡啊",
      "confidence": -0.3729
    },
    {
      "id": 44,
      "start": 72.12,
      "end": 73.08,
      "text": "你不打麻将呢",
      "confidence": -0.3729
    },
    {
      "id": 45,
      "start": 73.28,
      "end": 73.96,
      "text": "软脚",
      "confidence": -0.3729
    },
    {
      "id": 46,
      "start": 73.96,
      "end": 74.8,
      "text": "我有名字的",
      "confidence": -0.3729
    },
    {
      "id": 47,
      "start": 74.8,
      "end": 75.28,
      "text": "哦",
      "confidence": -0.3729
    },
    {
      "id": 48,
      "start": 75.28,
      "end": 76.4,
      "text": "那你叫什么名字啊",
      "confidence": -0.3729
    },
    {
      "id": 49,
      "start": 76.4,
      "end": 76.88,
      "text": "我叫",
      "confidence": -0.3729
    },
    {
      "id": 50,
      "start": 76.88,
      "end": 77.08,
      "text": "欸",
      "confidence": -0.3729
    },
    {
      "id": 51,
      "start": 77.08,
      "end": 77.68,
      "text": "我知道了",
      "confidence": -0.3729
    },
    {
      "id": 52,
      "start": 77.68,
      "end": 78.48,
      "text": "这写的呢",
      "confidence": -0.3729
    },
    {
      "id": 53,
      "start": 78.48,
      "end": 78.84,
      "text": "嗯",
      "confidence": -0.3729
    },
    {
      "id": 54,
      "start": 78.84,
      "end": 79.88,
      "text": "你叫",
      "confidence": -0.3729
    },
    {
      "id": 55,
      "start": 79.88,
      "end": 81.08,
      "text": "狂犬",
      "confidence": -0.3729
    },
    {
      "id": 56,
      "start": 81.08,
      "end": 81.52,
      "text": "蛤",
      "confidence": -0.3729
    },
    {
      "id": 57,
      "start": 82.4,
      "end": 83.64,
      "text": "你从没有才叫狂犬",
      "confidence": -0.3729
    },
    {
      "id": 58,
      "start": 83.64,
      "end": 84.92,
      "text": "你全家都叫狂犬",
      "confidence": -0.3729
    },
    {
      "id": 59,
      "start": 84.92,
      "end": 86.48,
      "text": "那你就上面就这么写的呀",
      "confidence": -0.3729
    },
    {
      "id": 60,
      "start": 86.48,
      "end": 87.16,
      "text": "狂犬",
      "confidence": -0.3729
    },
    {
      "id": 61,
      "start": 87.16,
      "end": 88.04,
      "text": "还这么多犬",
      "confidence": -0.3729
    },
    {
      "id": 62,
      "start": 88.04,
      "end": 88.48,
      "text": "你",
      "confidence": -0.3729
    },
    {
      "id": 63,
      "start": 88.48,
      "end": 90.28,
      "text": "你可记得别忘了打狂犬针哦",
      "confidence": -0.3729
    },
    {
      "id": 64,
      "start": 90.28,
      "end": 91.8,
      "text": "什么狂犬针啊",
      "confidence": -0.3729
    },
    {
      "id": 65,
      "start": 91.8,
      "end": 93.48,
      "text": "没事就多读点书行不行",
      "confidence": -0.3729
    },
    {
      "id": 66,
      "start": 93.48,
      "end": 95.72,
      "text": "对啊 这么简单的字你都不认识啊",
      "confidence": -0.2502
    },
    {
      "id": 67,
      "start": 95.72,
      "end": 97.0,
      "text": "你是不是傻",
      "confidence": -0.2502
    },
    {
      "id": 68,
      "start": 97.0,
      "end": 98.28,
      "text": "来 我教你",
      "confidence": -0.2502
    },
    {
      "id": 69,
      "start": 98.28,
      "end": 99.04,
      "text": "啊",
      "confidence": -0.2502
    },
    {
      "id": 70,
      "start": 99.04,
      "end": 100.84,
      "text": "狂 风",
      "confidence": -0.2502
    },
    {
      "id": 71,
      "start": 100.84,
      "end": 102.12,
      "text": "啊",
      "confidence": -0.2502
    },
    {
      "id": 72,
      "start": 102.12,
      "end": 103.08,
      "text": "你才是傻",
      "confidence": -0.2502
    },
    {
      "id": 73,
      "start": 103.08,
      "end": 104.2,
      "text": "风字我认识",
      "confidence": -0.2502
    },
    {
      "id": 74,
      "start": 104.2,
      "end": 105.2,
      "text": "旁边那个才是风",
      "confidence": -0.2502
    },
    {
      "id": 75,
      "start": 105.2,
      "end": 106.6,
      "text": "我们乡下人生的汉",
      "confidence": -0.2502
    },
    {
      "id": 76,
      "start": 106.6,
      "end": 108.04,
      "text": "认字只认半边",
      "confidence": -0.2502
    },
    {
      "id": 77,
      "start": 108.04,
      "end": 108.8,
      "text": "有问题吗",
      "confidence": -0.2502
    },
    {
      "id": 78,
      "start": 108.8,
      "end": 109.76,
      "text": "啊",
      "confidence": -0.2502
    },
    {
      "id": 79,
      "start": 109.76,
      "end": 111.68,
      "text": "那它旁边这三个拳怎么解释啊",
      "confidence": -0.2502
    },
    {
      "id": 80,
      "start": 111.68,
      "end": 112.56,
      "text": "呃",
      "confidence": -0.2502
    },
    {
      "id": 81,
      "start": 112.56,
      "end": 114.92,
      "text": "这三条狗是被这个风吹过来的",
      "confidence": -0.2502
    },
    {
      "id": 82,
      "start": 114.92,
      "end": 115.52,
      "text": "啊",
      "confidence": -0.2502
    },
    {
      "id": 83,
      "start": 115.52,
      "end": 118.57,
      "text": "你这刮的是狗风吧",
      "confidence": -0.2502
    },
    {
      "id": 84,
      "start": 118.57,
      "end": 119.41,
      "text": "拳有三个",
      "confidence": -0.2502
    },
    {
      "id": 85,
      "start": 119.41,
      "end": 120.37,
      "text": "按比例来说",
      "confidence": -0.2502
    },
    {
      "id": 86,
      "start": 120.37,
      "end": 121.45,
      "text": "那也应该念拳啊",
      "confidence": -0.2502
    },
    {
      "id": 87,
      "start": 121.45,
      "end": 122.25,
      "text": "念风",
      "confidence": -0.2502
    },
    {
      "id": 88,
      "start": 122.25,
      "end": 122.93,
      "text": "念拳",
      "confidence": -0.2502
    },
    {
      "id": 89,
      "start": 122.93,
      "end": 123.69,
      "text": "念风",
      "confidence": -0.2502
    },
    {
      "id": 90,
      "start": 123.69,
      "end": 126.25,
      "text": "念拳就狂风鸡狂拳鸡",
      "confidence": -0.2502
    },
    {
      "id": 91,
      "start": 126.25,
      "end": 127.93,
      "text": "狂风鸡狂拳鸡",
      "confidence": -0.2502
    },
    {
      "id": 92,
      "start": 127.93,
      "end": 128.97,
      "text": "你们够了哈",
      "confidence": -0.2502
    },
    {
      "id": 93,
      "start": 128.97,
      "end": 130.29,
      "text": "什么乱七八糟的",
      "confidence": -0.2502
    },
    {
      "id": 94,
      "start": 130.29,
      "end": 131.29,
      "text": "你才狂风鸡",
      "confidence": -0.2502
    },
    {
      "id": 95,
      "start": 131.29,
      "end": 132.33,
      "text": "你才狂拳鸡",
      "confidence": -0.2502
    },
    {
      "id": 96,
      "start": 132.33,
      "end": 133.01,
      "text": "听好了",
      "confidence": -0.2502
    },
    {
      "id": 97,
      "start": 133.01,
      "end": 134.49,
      "text": "我叫狂标鸡",
      "confidence": -0.2502
    },
    {
      "id": 98,
      "start": 134.49,
      "end": 136.45,
      "text": "不什么狂风鸡狂拳鸡",
      "confidence": -0.2502
    },
    {
      "id": 99,
      "start": 136.45,
      "end": 137.97,
      "text": "没文化就回去多念点说",
      "confidence": -0.2502
    },
    {
      "id": 100,
      "start": 137.97,
      "end": 139.89,
      "text": "实在不行就回去多养点猪",
      "confidence": -0.2502
    },
    {
      "id": 101,
      "start": 139.89,
      "end": 141.49,
      "text": "你是烦球的狗",
      "confidence": -0.2502
    }
