[
{
"start": 0.0,
"end": 1.9,
"text": "不说话还能圈粉全场"
},
{
"start": 1.9,
"end": 3.4,
"text": "鬼灭的第一反差萌"
},
{
"start": 3.4,
"end": 6.3,
"text": "祢豆子用行动告诉你 什么才叫萌翻观众"
},
{
"start": 6.3,
"end": 7.4,
"text": "打得过流氓"
},
{
"start": 7.4,
"end": 9.4,
"text": "祢豆子整日咬着竹筒"
},
{
"start": 9.4,
"end": 10.9,
"text": "根本不能开开口说话"
},
{
"start": 10.9,
"end": 12.4,
"text": "仅凭几句简单的发声"
},
{
"start": 12.4,
"end": 13.9,
"text": "跟一脸无辜的表情"
},
{
"start": 13.9,
"end": 15.6,
"text": "就融化了所有观众的心"
},
{
"start": 15.6,
"end": 18.2,
"text": "如果非要给祢豆子的可爱名场面排名"
},
{
"start": 18.2,
"end": 20.3,
"text": "那和香奈乎的首次交锋必进前三"
},
{
"start": 20.3,
"end": 22.7,
"text": "香奈乎敏锐的察觉到祢豆子的身份"
},
{
"start": 22.7,
"end": 24.3,
"text": "二话不说拔刀就砍"
},
{
"start": 24.3,
"end": 25.8,
"text": "眼看祢豆子就要受伤"
},
{
"start": 25.8,
"end": 27.2,
"text": "只见他不躲不闪"
},
{
"start": 27.2,
"end": 28.5,
"text": "身体骤然变小"
},
{
"start": 28.5,
"end": 30.1,
"text": "蹦跶着朝远处逃走"
},
{
"start": 30.1,
"end": 31.8,
"text": "香奈乎看的一脸懵逼"
},
{
"start": 31.8,
"end": 34.0,
"text": "完全没想到鬼界还有这么可爱的存在"
},
{
"start": 34.0,
"end": 35.5,
"text": "不过他并没有手软"
},
{
"start": 35.5,
"end": 37.1,
"text": "随后连续又是几刀"
},
{
"start": 37.1,
"end": 38.8,
"text": "祢豆子愣是听声辨位"
},
{
"start": 38.8,
"end": 40.5,
"text": "头也不回就化解了危机"
},
{
"start": 40.5,
"end": 42.1,
"text": "后来祢豆子遇上蜜璃"
},
{
"start": 42.1,
"end": 43.6,
"text": "那才叫一见如故"
},
{
"start": 43.6,
"end": 45.4,
"text": "也许小孩子都喜欢漂亮姐姐"
},
{
"start": 45.4,
"end": 47.1,
"text": "而且蜜璃那是真惯着她"
},
{
"start": 47.1,
"end": 48.8,
"text": "吃饭睡觉都不分开"
},
{
"start": 48.8,
"end": 50.1,
"text": "时间长了"
},
{
"start": 50.1,
"end": 51.5,
"text": "祢豆子一举一动"
},
{
"start": 51.5,
"end": 53.0,
"text": "都跟蜜璃一模一样"
},
{
"start": 53.0,
"end": 55.4,
"text": "甚至还让哥哥帮她也梳了蜜璃同款发型"
},
{
"start": 55.4,
"end": 57.0,
"text": "后来上了无限列车"
},
{
"start": 57.0,
"end": 58.7,
"text": "炭治郎昏睡不醒"
},
{
"start": 58.7,
"end": 60.5,
"text": "祢豆子用头暴力撞击"
},
{
"start": 60.5,
"end": 62.4,
"text": "没想到哥哥的头比他还硬"
},
{
"start": 62.4,
"end": 63.8,
"text": "直接额头出血"
},
{
"start": 63.8,
"end": 65.5,
"text": "即便有瞬间恢复的能力"
},
{
"start": 65.5,
"end": 67.2,
"text": "祢豆子依然是痛的流泪"
},
{
"start": 67.2,
"end": 68.8,
"text": "后来炭治郎醒了"
},
{
"start": 68.8,
"end": 70.1,
"text": "想靠近看看情况"
},
{
"start": 70.1,
"end": 71.9,
"text": "吓得祢豆子赶紧双手抱头"
},
{
"start": 71.9,
"end": 73.1,
"text": "生怕再次受伤"
},
{
"start": 73.1,
"end": 75.2,
"text": "由于她呆萌可爱的造型"
},
{
"start": 75.2,
"end": 77.0,
"text": "让人低估了她的战斗能力"
},
{
"start": 77.0,
"end": 78.8,
"text": "在游郭炭治郎重伤"
},
{
"start": 78.8,
"end": 80.6,
"text": "祢豆子被激发出二段进化"
},
{
"start": 80.6,
"end": 82.5,
"text": "即便位列上弦的堕姬"
},
{
"start": 82.5,
"end": 84.1,
"text": "在她手下也只有挨虐的份"
},
{
"start": 84.1,
"end": 85.9,
"text": "被祢豆子42号大脚"
},
{
"start": 85.9,
"end": 87.5,
"text": "活生生贯穿了身体"
},
{
"start": 87.5,
"end": 89.1,
"text": "祢豆子的血鬼术"
},
{
"start": 89.1,
"end": 90.7,
"text": "还具有非凡的治愈能力"
},
{
"start": 90.7,
"end": 92.5,
"text": "都知道妓夫太郎用的是梅毒"
},
{
"start": 92.5,
"end": 94.2,
"text": "一般方法根本不可能根治"
},
{
"start": 94.2,
"end": 96.0,
"text": "可毒素禁不住祢豆子鬼火焚烧"
},
{
"start": 96.0,
"end": 97.9,
"text": "这一幕吓坏了音柱的三位妻子"
},
{
"start": 97.9,
"end": 99.6,
"text": "她们一致认为"
},
{
"start": 99.6,
"end": 101.4,
"text": "是祢豆子要提前火化重伤的丈夫"
},
{
"start": 101.4,
"end": 103.0,
"text": "好歹也要抢救一下吧"
},
{
"start": 103.0,
"end": 104.3,
"text": "怎么还能提前火化"
},
{
"start": 104.3,
"end": 106.1,
"text": "刚变身厉鬼的祢豆子"
},
{
"start": 106.1,
"end": 107.7,
"text": "人类意识逐渐消失"
},
{
"start": 107.7,
"end": 109.6,
"text": "幸亏炭治郎从小哄她睡觉"
},
{
"start": 109.6,
"end": 111.4,
"text": "知道妹妹最爱听的歌曲"
},
{
"start": 111.4,
"end": 113.1,
"text": "用儿歌唤起了她的记忆"
},
{
"start": 113.1,
"end": 114.7,
"text": "祢豆子想起了自己的母亲"
},
{
"start": 114.7,
"end": 116.7,
"text": "同时她瞪着一双大眼的可爱造型"
},
{
"start": 116.7,
"end": 118.6,
"text": "也成了无数观众的梦中情娃"
},
{
"start": 118.6,
"end": 120.3,
"text": "祢豆子恢复了人性"
},
{
"start": 120.3,
"end": 122.0,
"text": "身体也缩成了迷你版本"
},
{
"start": 122.0,
"end": 123.0,
"text": "他蜷成一团"
},
{
"start": 123.0,
"end": 124.6,
"text": "在哥哥脚下沉沉睡去"
},
{
"start": 124.6,
"end": 126.1,
"text": "随着战斗经验的增加"
},
{
"start": 126.1,
"end": 128.0,
"text": "祢豆子已经能够控制鬼化程度"
},
{
"start": 128.0,
"end": 129.4,
"text": "就比如在锻刀村"
},
{
"start": 129.4,
"end": 131.0,
"text": "听到炭治郎叫自己名字"
},
{
"start": 131.0,
"end": 132.8,
"text": "仍然呆萌的举手给出反应"
},
{
"start": 132.8,
"end": 134.5,
"text": "祢豆子平时被哥哥保护"
},
{
"start": 134.5,
"end": 136.2,
"text": "危险时反过来救他于水火"
},
{
"start": 136.2,
"end": 137.4,
"text": "不管多么危险"
},
{
"start": 137.4,
"end": 139.0,
"text": "兄妹二人从没想过放弃对方"
},
{
"start": 139.0,
"end": 140.7,
"text": "这样又萌又飒的妹妹"
},
{
"start": 140.7,
"end": 142.1,
"text": "谁不想拥有一个呢"
}
]